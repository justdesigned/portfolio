---
const socials = [
  { label: 'GitHub', href: 'https://github.com', icon: '/figma/5edaa537-f690-4784-9a78-0983f719cc0e.svg' },
  { label: 'LinkedIn', href: 'https://linkedin.com', icon: '/figma/ec78c76b-9d98-4bdc-8dd1-6bcbecfac283.svg' },
];
---

<footer class="border-t border-white/5 px-5 pb-10 pt-12 md:px-10 xl:px-20">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-3">
        <div class="flex size-6 items-center justify-center rounded-sm bg-violet-500 text-[10px] font-black text-[#09090b]">
          AC
        </div>
        <span class="font-display text-base font-semibold tracking-[-0.04em] text-zinc-50">Alex Carter</span>
        <span class="text-sm text-zinc-400">— Web Developer</span>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        {socials.map((item) => (
          <a href={item.href} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 text-sm text-zinc-400 transition-colors hover:text-zinc-100">
            <img src={item.icon} alt="" class="h-4 w-4" />
            {item.label}
          </a>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-1 border-t border-white/5 pt-6 text-sm text-zinc-500 md:flex-row md:items-center md:justify-between">
      <p>© 2024 Alex Carter</p>
      <p>Built with Astro + Tailwind</p>
    </div>
  </div>
</footer>
