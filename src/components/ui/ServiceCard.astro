---
interface Props {
	number: string;
	title: string;
	description: string;
	icon: any;
}

const { number, title, description, icon } = Astro.props;
const Icon = icon;
---

<article
	class="rounded-2xl border border-white/5 bg-[#141417] p-6 shadow-[0_0_0_1px_rgba(255,255,255,0.02)] sm:p-8"
>
	<div class="mb-6 flex items-center justify-between gap-3 sm:mb-8">
		<span
			class="font-mono-code text-sm font-semibold uppercase tracking-[0.12em] text-cyan-300"
		>
			{number}
		</span>
		<Icon class="h-5 w-5" aria-hidden="true" />
	</div>

	<div class="space-y-3">
		<h3
			class="font-display text-[1.2rem] font-semibold tracking-[-0.04em] text-zinc-50 sm:text-[1.35rem]"
		>
			{title}
		</h3>
		<p class="text-sm leading-6 text-zinc-400 sm:text-[0.95rem] sm:leading-7">{description}</p>
	</div>
</article>
