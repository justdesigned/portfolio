---
interface Props {
	title: string;
	icon: any;
	items: string[];
}

const { title, icon, items } = Astro.props;
const Icon = icon;
---

<div
	class="rounded-2xl border border-white/5 bg-[#141417] p-6 shadow-[0_0_0_1px_rgba(255,255,255,0.02)] sm:p-8"
>
	<div class="mb-5 flex items-center justify-between gap-3 sm:mb-7">
		<h3
			class="font-display text-[1.15rem] font-semibold tracking-[-0.04em] text-zinc-50 sm:text-[1.3rem]"
		>
			{title}
		</h3>
		<Icon class="h-5 w-5" aria-hidden="true" />
	</div>

	<ul class="space-y-3">
		{
			items.map((item) => (
				<li class="flex items-center gap-3 text-zinc-300">
					<span class="inline-block h-2 w-2 rounded-full bg-cyan-400" />
					<span class="font-medium text-[0.9rem] text-zinc-400 sm:text-[0.95rem]">{item}</span>
				</li>
			))
		}
	</ul>
</div>
