---
import { Image } from 'astro:assets';
import contactGlow from '../../assets/background/contact-glow.svg';
import EmailIcon from '../../assets/icons/email.svg';
import ArrowRightIcon from '../../assets/icons/arrow-right.svg';
---

<section
	id='contact'
	class='relative overflow-hidden px-4 py-20 sm:px-5 md:px-10 md:py-24 xl:px-20'>
	<div
		class='absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 opacity-80'>
		<Image
			src={contactGlow}
			alt=''
			width={800}
			height={400}
			class='h-75 w-150 md:h-100 md:w-200'
		/>
	</div>

	<div
		class='relative mx-auto max-w-200 rounded-4xl border border-white/5 bg-zinc-950/60 px-5 py-12 text-center shadow-[0_0_0_1px_rgba(255,255,255,0.02)] backdrop-blur-sm sm:px-6 md:px-10 md:py-20'>
		<div class='space-y-5'>
			<p
				class='font-mono-code text-[13px] font-semibold uppercase tracking-[0.16em] text-violet-400 sm:text-[14px]'>
				Get In Touch
			</p>
			<h2
				class='font-display text-[clamp(2.2rem,6vw,3.5rem)] font-extrabold tracking-[-0.06em] text-zinc-50'>
				Let's Work Together
			</h2>
			<p
				class='mx-auto max-w-145 text-base leading-7 text-zinc-400 sm:text-lg sm:leading-8'>
				Have a project in mind or looking for a developer? I'd love to hear from
				you.
			</p>
		</div>

		<div class='mt-8 flex flex-col items-center gap-5 sm:mt-10 sm:gap-6'>
			<a
				href='mailto:hello@alexcarter.dev'
				class='inline-flex items-center gap-3 rounded-lg px-7 py-3.5 text-[15px] font-semibold text-zinc-50 transition-colors hover:text-cyan-200'>
				<span>Send Me a Message</span>
				<ArrowRightIcon class='h-4 w-4' aria-hidden='true' />
			</a>

			<div class='flex items-center gap-2 text-zinc-50'>
				<EmailIcon class='h-4 w-4' aria-hidden='true' />
				<a
					href='mailto:hello@alexcarter.dev'
					class='font-mono-code text-[14px] text-zinc-50 sm:text-[15px]'>
					hello@alexcarter.dev
				</a>
			</div>
		</div>
	</div>
</section>
