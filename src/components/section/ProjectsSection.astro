---
import SectionHeader from '../ui/SectionHeader.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import finovaImage from '../../assets/images/project-finova.svg';
import shoplineImage from '../../assets/images/project-shopline.svg';
import devpulseImage from '../../assets/images/project-devpulse.svg';

const projects = [
	{
		title: 'Finova Dashboard',
		description:
			'Real-time analytics platform for fintech startup. Complex data visualization with performant rendering.',
		image: finovaImage,
		tags: ['React', 'D3.js', 'Node.js'],
	},
	{
		title: 'Shopline',
		description:
			'E-commerce platform with headless CMS, dynamic filtering, and Stripe integration.',
		image: shoplineImage,
		tags: ['Next.js', 'Sanity', 'Stripe'],
	},
	{
		title: 'DevPulse',
		description:
			'Developer productivity tool with GitHub integration, sprint tracking, and team insights.',
		image: devpulseImage,
		tags: ['TypeScript', 'PostgreSQL', 'GraphQL'],
	},
];
---

<section id="projects" class="px-5 py-24 md:px-10 xl:px-20">
	<div class="mx-auto max-w-[1440px]">
		<SectionHeader eyebrow="03 / Portfolio" title="Selected Projects" />

		<div class="mt-16 grid gap-6 xl:grid-cols-3">
			{
				projects.map((project) => (
					<ProjectCard
						title={project.title}
						description={project.description}
						image={project.image}
						tags={project.tags}
					/>
				))
			}
		</div>
	</div>
</section>
