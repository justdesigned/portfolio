---
import SectionHeader from '../ui/SectionHeader.astro';
import SkillCard from '../ui/SkillCard.astro';
import SkillFrontendIcon from '../../assets/icons/skill-frontend.svg';
import SkillBackendIcon from '../../assets/icons/skill-backend.svg';
import SkillToolsIcon from '../../assets/icons/skill-tools.svg';
import SkillOtherIcon from '../../assets/icons/skill-other.svg';

const skillGroups = [
	{
		title: 'Frontend',
		icon: SkillFrontendIcon,
		items: ['React', 'TypeScript', 'Next.js', 'Tailwind CSS'],
	},
	{
		title: 'Backend',
		icon: SkillBackendIcon,
		items: ['Node.js', 'Express', 'PostgreSQL', 'Redis'],
	},
	{
		title: 'Tools & Workflow',
		icon: SkillToolsIcon,
		items: ['Git', 'Docker', 'Vercel', 'Figma'],
	},
	{
		title: 'Other',
		icon: SkillOtherIcon,
		items: ['REST APIs', 'GraphQL', 'CI/CD', 'Testing'],
	},
];
---

<section id="skills" class="px-4 py-20 sm:px-5 md:px-10 md:py-24 xl:px-20">
	<div class="mx-auto max-w-[1440px]">
		<SectionHeader eyebrow="02 / Expertise" title="Tech Stack" />

		<div class="mt-10 grid gap-6 md:mt-12 md:grid-cols-2 xl:mt-16 xl:grid-cols-4">
			{
				skillGroups.map((group) => (
					<SkillCard
						title={group.title}
						icon={group.icon}
						items={group.items}
					/>
				))
			}
		</div>
	</div>
</section>
