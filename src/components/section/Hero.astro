---
import ArrowRight from '../../assets/icons/arrow-right.svg';
import bgImage from '../../assets/background/hero-bg-w940.svg';

const primaryCta = {
	href: '#projects',
	label: 'View My Work',
};

const secondaryCta = {
	href: '#contact',
	label: 'Get In Touch',
};
---

<section class='relative overflow-hidden pb-35 pt-35'>
	<div
		class='absolute left-1/2 top-[42%] -translate-x-1/2 -translate-y-1/2 opacity-80 select-none h-147.5 w-235 bg-no-repeat bg-cover'
		style={`background-image: url(${bgImage.src})`}>
	</div>

	<div
		class='relative flex flex-col items-center mx-auto max-w-230 text-center'>
		<div
			class='inline-flex items-center gap-2 rounded-full border border-purple-500/19 bg-purple-500/7 px-4 py-2'>
			<div class='h-2 w-2 bg-cyan-500 rounded-full'></div>

			<div
				class='font-mono-code text-[12px] font-semibold uppercase tracking-[0.16em] text-zinc-50'>
				Portfolio 2024
			</div>
		</div>

		<h1
			class='mt-3 font-display text-[clamp(3rem,6vw,5rem)] font-extrabold leading-[1.05] tracking-[-0.06em] text-gray-50'>
			I build digital experiences that perform
		</h1>

		<p class='mt-10 max-w-160 text-lg leading-8 text-gray-400'>
			Full-stack web developer specializing in modern JavaScript, scalable
			architectures, and pixel-perfect interfaces.
		</p>

		<div class='mt-10 flex flex-wrap items-center justify-center gap-4'>
			<a
				href={primaryCta.href}
				class='inline-flex items-center gap-2 rounded-lg bg-transparent px-7 py-3.5 text-[15px] font-semibold text-gray-50 transition-colors hover:text-cyan-200'>
				<span>{primaryCta.label}</span>

				<ArrowRight />
			</a>

			<a
				href={secondaryCta.href}
				class='inline-flex items-center rounded-lg border border-white/10 bg-gray-900 px-7 py-3.5 text-[15px] font-medium text-gray-50 transition-colors hover:border-white/20'>
				{secondaryCta.label}
			</a>
		</div>
	</div>
</section>
