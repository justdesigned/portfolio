---
import ArrowRight from '../../assets/icons/arrow-right.svg';
import bgImage from '../../assets/background/hero-bg-w940.svg';

const primaryCta = {
	href: '#projects',
	label: 'View My Work',
};

const secondaryCta = {
	href: '#contact',
	label: 'Get In Touch',
};
---

<section
	class="relative overflow-hidden pb-20 pt-18 sm:pb-24 sm:pt-20 md:pb-30 md:pt-24 lg:pb-32 lg:pt-28"
>
	<div
		class="absolute left-1/2 top-[42%] h-147.5 w-235 -translate-x-1/2 -translate-y-1/2 select-none bg-cover bg-no-repeat opacity-80 sm:h-128 sm:w-3xl lg:h-147.5 lg:w-235"
		style={`background-image: url(${bgImage.src})`}
	>
	</div>

	<div
		class="relative mx-auto flex max-w-230 flex-col items-center px-4 text-center sm:px-6"
	>
		<div
			class="inline-flex items-center gap-2 rounded-full border border-purple-500/19 bg-purple-500/7 px-4 py-2"
		>
			<div class="h-2 w-2 rounded-full bg-cyan-500"></div>

			<div
				class="font-mono-code text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-50 sm:text-[12px]"
			>
				Available for Hire
			</div>
		</div>

		<h1
			class="mt-6 max-w-[15ch] font-display text-[clamp(3rem,7vw,5rem)] font-extrabold leading-[0.92] tracking-[-0.06em] text-zinc-50 sm:mt-8 lg:max-w-[18ch]"
		>
			Frontend Engineer who ships fast, clean code
		</h1>

		<p
			class="mt-6 max-w-160 text-base leading-7 text-zinc-400 sm:text-lg sm:leading-8 md:mt-8"
		>
			React · Next.js · TypeScript specialist with 5+ years building scalable
			UIs, reusable component systems, and production-grade web apps.
		</p>

		<div
			class="mt-8 flex w-full max-w-lg flex-col items-center justify-center gap-4 sm:mt-10 sm:flex-row"
		>
			<a
				href={primaryCta.href}
				class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-transparent px-7 py-3.5 text-[15px] font-semibold text-zinc-50 transition-colors hover:text-cyan-200 sm:w-auto"
			>
				<span>{primaryCta.label}</span>

				<ArrowRight />
			</a>

			<a
				href={secondaryCta.href}
				class="inline-flex w-full items-center justify-center rounded-lg border border-white/10 bg-gray-900 px-7 py-3.5 text-[15px] font-medium text-zinc-50 transition-colors hover:border-white/20 sm:w-auto"
			>
				{secondaryCta.label}
			</a>
		</div>
	</div>
</section>
