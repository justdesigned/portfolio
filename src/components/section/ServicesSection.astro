---
import SectionHeader from '../ui/SectionHeader.astro';
import ServiceCard from '../ui/ServiceCard.astro';
import ArrowRightUpIcon from '../../assets/icons/arrow-up-right.svg';

const services = [
	{
		number: '01',
		title: 'React & Next.js Development',
		description:
			'Building scalable web applications with React, Next.js, and TypeScript — from landing pages to complex SPAs with server-side rendering.',
		icon: ArrowRightUpIcon,
	},
	{
		number: '02',
		title: 'UI Implementation',
		description:
			'Pixel-perfect translation of Figma designs into responsive, production-ready code using Tailwind CSS, Shadcn/UI, and modern component patterns.',
		icon: ArrowRightUpIcon,
	},
	{
		number: '03',
		title: 'Frontend Consulting',
		description:
			'Architecture reviews, performance optimization, and refactoring legacy codebases to modern React and TypeScript standards.',
		icon: ArrowRightUpIcon,
	},
];
---

<section id="services" class="px-4 py-20 sm:px-5 md:px-10 md:py-24 xl:px-20">
	<div class="mx-auto max-w-360">
		<SectionHeader eyebrow="04 / Solutions" title="What I Do" />

		<div
			class="mt-10 grid gap-6 md:mt-12 md:grid-cols-2 xl:mt-16 xl:grid-cols-3"
		>
			{
				services.map((service) => (
					<ServiceCard
						number={service.number}
						title={service.title}
						description={service.description}
						icon={service.icon}
					/>
				))
			}
		</div>
	</div>
</section>
