---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="flex flex-col gap-3">
  <p class="font-mono-code text-[14px] font-semibold uppercase tracking-[0.14em] text-violet-400">
    {eyebrow}
  </p>
  <h2 class="font-display text-[clamp(2.25rem,4vw,2.75rem)] font-bold tracking-[-0.06em] text-zinc-50">
    {title}
  </h2>
  <div class="h-px w-20 bg-gradient-to-r from-violet-400 to-cyan-400"></div>
</div>
