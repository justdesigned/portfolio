---
const primaryCta = {
  href: '#projects',
  label: 'View My Work',
};

const secondaryCta = {
  href: '#contact',
  label: 'Get In Touch',
};
---

<section id="top" class="relative overflow-hidden px-5 pb-24 pt-16 md:px-10 xl:px-20">
  <div class="absolute left-1/2 top-[42%] -translate-x-1/2 -translate-y-1/2 opacity-80">
    <img src="/figma/88eb7358-b320-414d-bdb1-aea557c23998.svg" alt="" class="h-[350px] w-[700px]" />
  </div>

  <div class="relative mx-auto max-w-[920px] pt-24 text-center">
    <div class="mx-auto inline-flex items-center gap-2 rounded-full border border-violet-400/20 bg-violet-500/5 px-4 py-2">
      <img src="/figma/9d468d2f-4bbb-4ccb-b5af-7aaab5633b5f.svg" alt="" class="h-2 w-2" />
      <span class="font-mono-code text-[12px] font-semibold uppercase tracking-[0.16em] text-zinc-50">
        Portfolio 2024
      </span>
    </div>

    <h1 class="mt-10 font-display text-[clamp(3rem,6vw,5rem)] font-extrabold leading-[1.05] tracking-[-0.06em] text-zinc-50">
      I build digital experiences that perform
    </h1>

    <p class="mx-auto mt-8 max-w-[640px] text-lg leading-8 text-zinc-400">
      Full-stack web developer specializing in modern JavaScript, scalable architectures, and pixel-perfect interfaces.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={primaryCta.href}
        class="inline-flex items-center gap-2 rounded-lg bg-transparent px-7 py-3.5 text-[15px] font-semibold text-zinc-50 transition-colors hover:text-cyan-200"
      >
        <span>{primaryCta.label}</span>
        <img src="/figma/34bb152d-0010-47d0-9a49-6a36ebbca635.svg" alt="" class="h-4 w-4" />
      </a>

      <a
        href={secondaryCta.href}
        class="inline-flex items-center rounded-lg border border-white/10 bg-[#141417] px-7 py-3.5 text-[15px] font-medium text-zinc-50 transition-colors hover:border-white/20"
      >
        {secondaryCta.label}
      </a>
    </div>
  </div>
</section>
